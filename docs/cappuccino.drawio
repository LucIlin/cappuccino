        <mxCell id="PyBoHMX9XphBMzt64NYl-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cappuccino&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400; text-align: center;&quot;&gt;Build an app that let&#39;s users be notified of spontaeneus and unplanned events.&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;h2&gt;&lt;span style=&quot;font-weight: 400; text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Goal cases:&lt;/font&gt;&lt;/span&gt;&lt;/h2&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&quot;Notify me when my favorite band *band name* is playing in my city.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;text-align: center;&quot;&gt;Remind me when I&#39;m in the supermarket to buy *grocery*.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;text-align: center;&quot;&gt;Notify me ahead of time when the Northern lights will show outside my window.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;text-align: center;&quot;&gt;Notify me when *product* is on sale at *website*.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;Communication language:&amp;nbsp;&lt;br&gt;&lt;ul&gt;&lt;li&gt;&lt;em&gt;&quot;let&#39;s fill in the details of your subscription.&quot;&lt;/em&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="420" width="510" y="260" as="geometry" />
        </mxCell>
